{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lokal-ai-gateway",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ORIGIN": "https://ai.smalan.sch.id",
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_YOUR_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "ALLOWED_EMAILS": "REPLACE_WITH_ALLOWED_EMAILS",
    "OPENAI_ALLOWED_MODELS": "gpt-6.1-sol,gpt-6-luna"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "ai.smalan.sch.id/api/*",
      "zone_name": "smalan.sch.id"
    }
  ]
}
